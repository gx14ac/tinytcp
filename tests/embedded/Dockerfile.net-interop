FROM ubuntu:24.04

RUN apt-get update && apt-get install -y --no-install-recommends \
    qemu-system-arm \
    iproute2 \
    iputils-ping \
    netcat-openbsd \
    arping \
    ethtool \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /work

# Copy pre-built binary and test script
COPY zig-out/bin/embedded-net zig-out/bin/embedded-net
COPY tests/embedded/run_net_interop.sh tests/embedded/run_net_interop.sh

ENTRYPOINT ["tests/embedded/run_net_interop.sh"]
